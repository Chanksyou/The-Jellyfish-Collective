<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}Jellyfish Collective{% else %}{{ title }} · Jellyfish Collective{% endif %}</title>
<meta name="description" content="{{ tagline | default('The Jellyfish Collective builds immersive activations, lounges, and pop-up music spaces at festivals and regional burns.') }}">

<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ tagline }}">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500&family=Karla:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">

<link rel="icon" href="/img/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <a class="wordmark" href="/">
    <img class="wordmark__logo" src="/img/logo.png" alt="" width="120" height="109" decoding="async">
    <span class="wordmark__text">
      <span class="wordmark__jelly">Jellyfish</span>
      <span class="wordmark__collective">Collective</span>
    </span>
  </a>
  <nav aria-label="Primary">
    <a href="/how-it-works/">How it works</a>
    <a href="/activations/past/">Activations</a>
    <a href="/technical/">How we build</a>
    <a href="/join/">Join</a>
  </nav>
</header>

{% if page.url == "/" %}
<div class="hero" aria-hidden="true">
  <div class="hero__bloom"></div>
  <svg class="jelly" viewBox="0 0 240 420" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="bell" cx="50%" cy="38%" r="62%">
        <stop offset="0%" stop-color="var(--bell-hot)" stop-opacity="0.95"/>
        <stop offset="55%" stop-color="var(--bell)" stop-opacity="0.55"/>
        <stop offset="100%" stop-color="var(--tendril)" stop-opacity="0.15"/>
      </radialGradient>
      <linearGradient id="strand" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--bell)" stop-opacity="0.75"/>
        <stop offset="70%" stop-color="var(--tendril)" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="var(--tendril)" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <g class="jelly__body">
      <path class="jelly__bell" fill="url(#bell)"
        d="M104 26c52 0 92 42 92 94 0 26-10 44-22 54-10 8-22 6-28-2-6 8-18 10-26 2-6 8-20 8-26 0-8 8-20 6-28-2-12-10-22-28-22-52 0-52 40-94 92-94z"/>
      <path class="jelly__rim" fill="none" stroke="var(--bell-hot)" stroke-opacity="0.5" stroke-width="1.5"
        d="M64 168c8 10 22 12 30 4 8 8 22 8 28 0 6 8 20 6 26-2 6 8 18 10 28 2"/>
    </g>

    <g class="jelly__tendrils" stroke="url(#strand)" fill="none" stroke-linecap="round">
      <path class="t t1" stroke-width="2.5" d="M84 178c-6 60 10 96 2 150"/>
      <path class="t t2" stroke-width="1.5" d="M104 180c4 70-12 108-4 158"/>
      <path class="t t3" stroke-width="3" d="M120 182c0 74 8 112 0 162"/>
      <path class="t t4" stroke-width="1.5" d="M136 180c-4 70 12 108 4 158"/>
      <path class="t t5" stroke-width="2.5" d="M156 178c6 60-10 96-2 150"/>
    </g>
  </svg>
</div>
{% endif %}

<main id="main" class="prose {% if page.url == '/' %}prose--home{% endif %}">
  {% if page.url != "/" %}
  <div class="pagehead">
    <p class="eyebrow">Jellyfish Collective</p>
    <h1>{{ title }}</h1>
    {% if tagline %}<p class="lede">{{ tagline }}</p>{% endif %}
  </div>
  {% endif %}

  {{ content | safe }}
</main>

<footer class="footer">
  <p class="footer__mark">Jellyfish Collective</p>
  <nav aria-label="Footer">
    <a href="/how-it-works/">How it works</a>
    <a href="/activations/past/">Past</a>
    <a href="/activations/upcoming/">Upcoming</a>
    <a href="/technical/">How we build</a>
    <a href="/join/">Join</a>
    <a href="https://www.instagram.com/the_jellyfish_collective">Instagram</a>
  </nav>
  <p class="footer__note">Leave no trace.</p>
</footer>

</body>
</html>
