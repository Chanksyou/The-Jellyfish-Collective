<div class="activation-gallery">
  <figure class="photo-featured">
    <img src="{{ photos[0].src }}" alt="{{ photos[0].alt }}" loading="lazy">
  </figure>
  <figure class="photo-sm">
    <img src="{{ photos[1].src }}" alt="{{ photos[1].alt }}" loading="lazy">
  </figure>
  <figure class="photo-sm">
    <img src="{{ photos[2].src }}" alt="{{ photos[2].alt }}" loading="lazy">
  </figure>
  <figure class="photo-sm">
    <img src="{{ photos[3].src }}" alt="{{ photos[3].alt }}" loading="lazy">
  </figure>
  <a href="{{ ctaLink }}" class="photo-cta">
    <span class="photo-cta__label">{{ ctaLabel }}</span>
    <span class="photo-cta__arrow">Full details →</span>
  </a>
</div>
